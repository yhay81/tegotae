{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tegotae",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "tegotae.yhay81.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tegotae",
      "database_id": "99c344e4-4c1c-48ca-b98f-f181288c533d",
    },
  ],
  "triggers": {
    "crons": ["17 19 * * *"],
  },
}
